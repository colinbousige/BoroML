# n2p2 environment loaded inside generated training jobs.
# Ensure nnp-scaling and nnp-train are available in PATH.

module purge
module load gcc/12
module load openmpi/4.1

# Example custom installation path (edit as needed)
export N2P2_ROOT=/path/to/n2p2
export PATH="$N2P2_ROOT/bin:$PATH"
export LD_LIBRARY_PATH="$N2P2_ROOT/lib:${LD_LIBRARY_PATH:-}"

# Optional diagnostics
which nnp-scaling || true
which nnp-train || true
