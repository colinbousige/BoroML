# VASP runtime environment loaded inside DFT jobs.
# Ensure `vasp_std` is available to srun.

module purge
module load gcc/12
module load openmpi/4.1
module load vasp

# If VASP is installed manually, set PATH/LD_LIBRARY_PATH accordingly.
# export PATH=/path/to/vasp/bin:$PATH

# Optional diagnostics
which vasp_std || true
