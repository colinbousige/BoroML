#!/bin/bash
# Generic SLURM header template used by NAPS scripts.
# Must keep the placeholders NNODES and jobname.

#SBATCH -J jobname
#SBATCH -N NNODES
#SBATCH -n 1
#SBATCH -c 1
#SBATCH -t 24:00:00
#SBATCH -A your_account
#SBATCH -p your_partition
#SBATCH -o slurm-%x-%j.out
#SBATCH -e slurm-%x-%j.err

set -euo pipefail

# Optional: print job context
echo "[$(date +%F' '%T)] job=$SLURM_JOB_NAME id=$SLURM_JOB_ID nodes=$SLURM_JOB_NUM_NODES"
