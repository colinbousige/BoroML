# LAMMPS runtime environment loaded inside MD-test jobs.
# Ensure the command `lmp` is available.

module purge
module load gcc/12
module load openmpi/4.1
module load lammps

# If your binary name is not `lmp`, create an alias or wrapper in PATH.
# Example:
# export PATH=/path/to/lammps/bin:$PATH

# Optional diagnostics
which lmp || true
