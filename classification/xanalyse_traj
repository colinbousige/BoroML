def analyse(infile, thres=threshold, minarea=800, maxarea=5000, dpi=200, pointsize=400):
    """
    Function to analyse a holes organization in a trajectory of atoms
    """
    # # # # # # # # # # # # # # # # # # # # # # # # #
    # Read atoms positions and center them
    # # # # # # # # # # # # # # # # # # # # # # # # #
    atoms, timesteps = read_lammps(infile)
    zmean = []
    outfile = infile.split("/")[-1].replace(".lammpstrj", "")
    for k, at in enumerate(atoms):
        Bid = atoms[k].symbols.search('B')
        a = atoms[k].cell[0, 0]
        b = atoms[k].cell[1, 1]
        COM = atoms[k][Bid].get_center_of_mass()
        # center x and y coordinates around the center of mass
        atoms[k].positions[:, 0] = atoms[k].positions[:, 0] - COM[0] + a/2
        atoms[k].positions[:, 1] = atoms[k].positions[:, 1] - COM[1] + b/2
        # apply periodic boundary conditions
        atoms[k].positions[:, 0] = atoms[k].positions[:, 0] % a
        atoms[k].positions[:, 1] = atoms[k].positions[:, 1] % b
        zmean.append(np.mean(atoms[k].positions[Bid, 2]))
    # # # # # # # # # # # # # # # # # # # # # # # # #
    # Detect all holes and save as trajectory
    # # # # # # # # # # # # # # # # # # # # # # # # #
    sys.stderr.write(f"Finding holes in {infile}\n")
    sys.stderr.flush()
    holes = [detect_holes(at, dpi=dpi, pointsize=pointsize,
                          minarea=minarea, maxarea=maxarea) for at in atoms]
    at_holes = []
    allotrope = []
    sys.stderr.write(f"Finding allotropes for {infile}\n")
    sys.stderr.flush()
    for i, h in enumerate(holes):
        if len(h) > 0:
            x = h.x.values
            y = h.y.values
            # Create an array of the same length as x, filled with zmean[i]
            z = np.full_like(x, zmean[i])
            positions = np.c_[x, y, z]
            at_holes.append(Atoms("X"*len(h),
                                  positions=positions,
                                  cell=atoms[i].cell))
            temp = Atoms(
                symbols=["He"] * len(h),
                positions=positions,
                cell=atoms[i].cell
            )
            if len(temp) == 0:
                allotrope.append((np.array([]), np.array([])))
                continue
            allotrope.append(predict_allo(atoms=temp, pca=pca, threshold=thres,
                                          model=model, xscaler=scaler, encoder=None,
                                          nbins=nbins, rcut=rcut, sigma=sigma,
                                          w_scale=w_scale))
            at_holes[-1].arrays['allotrope'] = allotrope[-1][0]
        else:
            at_holes.append(Atoms('', cell=atoms[i].cell))
    atomsANDholes = [at1 + at2 for at1, at2 in zip(atoms, at_holes)]
    # save at_holes as a trajectory
    write_lammps_traj(
        atomsANDholes, f'AttribVac_{outfile}.lammpstrj', allotrope=True, energies=False)
    # # # # # # # # # # # # # # # # # # # # # # # # #
    # Use the saved model to predit allotropes and certainties on holes trajectory
    # # # # # # # # # # # # # # # # # # # # # # # # #
    sys.stderr.write(f"Saving allotrope data for {infile}\n")
    sys.stderr.flush()
    allotrope_labels = [allo[0] for allo in allotrope]
    # make a tidy DataFrame of the number of each allotrope per frame
    # columnnames are 'timestep', 'allotrope', 'count
    # possible allotropes are in `classes`, plus 'unknown'
    # 'timestep' is from `timesteps`
    # 'count' is the number of atoms of each allotrope in the frame
    # forget about certainties for now
    allo_counts = []
    possible_allotropes = list(classes) + ['unknown']
    for allo_labels in possible_allotropes:
        for i, labels in enumerate(allotrope_labels):
            count = np.sum(labels == allo_labels)
            allo_counts.append({'timestep': timesteps[i],
                                'allotrope': allo_labels,
                                'count': count,
                                'Natoms': len(atoms[i])})
    allo_df = pd.DataFrame(allo_counts)
    allo_df.to_csv(f'analyse_{outfile}.csv', index=False)

