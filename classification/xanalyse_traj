def detect_holes(atoms, dpi=200, pointsize=400, minarea=800, maxarea=5000, plot=False):
    """
    Function to detect holes in a 2D image of atoms using OpenCV
    """
    import io
    import cv2
    import numpy as np

    def get_img_from_fig(atoms, dpi=200):
        """
        Convert a Matplotlib figure to a numpy array with RGB channels
        """
        fig, ax = plt.subplots()
        ax.scatter(atoms.positions[:, 0],
                   atoms.positions[:, 1], c='k', s=pointsize)
        ax.set(xlim=(0, atoms.cell[0, 0]), ylim=(
            0, atoms.cell[1, 1]), aspect='equal')
        ax.set_axis_off()
        ax.margins(0)
        fig.tight_layout(pad=0)
        buf = io.BytesIO()
        fig.savefig(buf, format="png", dpi=dpi,
                    bbox_inches='tight', pad_inches=0)
        plt.close(fig)
        buf.seek(0)
        img = cv2.imdecode(np.frombuffer(
            buf.getvalue(), dtype=np.uint8), cv2.IMREAD_COLOR)
        buf.close()
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        return cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)

    Batoms = atoms.symbols.search('B')
    img = get_img_from_fig(atoms[Batoms], dpi=dpi)
    a = atoms.cell[0, 0]
    b = atoms.cell[1, 1]
    xdim, ydim = img.shape[1], img.shape[0]

    params = cv2.SimpleBlobDetector_Params()
    params.filterByArea = True
    params.filterByInertia = False
    params.filterByConvexity = False
    params.filterByCircularity = False
    params.minArea = minarea
    params.maxArea = maxarea
    params.blobColor = 255
    detector = cv2.SimpleBlobDetector_create(params)
    keypoints = detector.detect(img)

    keypointsdf = pd.DataFrame(
        [[keyPoint.pt[0]/xdim*a, b-keyPoint.pt[1]/ydim*b, keyPoint.size/ydim*b/xdim*a]
            for keyPoint in keypoints],
        columns=['x', 'y', 's']
    )
    # keypointsdf = keypointsdf[keypointsdf.s > 0.02]

    if plot:
        fig, ax = plt.subplots()
        ax.scatter(atoms.positions[Batoms, 0],
                   atoms.positions[Batoms, 1], c='k', s=pointsize, label='B atoms')
        ax.set(xlim=(0, atoms.cell[0, 0]), ylim=(
            0, atoms.cell[1, 1]), aspect='equal')
        # ax.set_axis_off()
        ax.margins(0)
        fig.tight_layout(pad=0)

        # Vérifier que keypointsdf n'est pas vide
        if not keypointsdf.empty:
            # Convertir s en tableau NumPy pour éviter les erreurs de type
            s_values = np.array(keypointsdf.s * pointsize)
            ax.scatter(keypointsdf.x, keypointsdf.y, s=s_values,
                       c='r', label='Detected Vacancies', alpha=0.5)
            print(f"Detected {len(keypointsdf)} vacancies.")
        else:
            print("No vacancies detected.")

        plt.legend()
        plt.tight_layout()
        plt.show()

    return keypointsdf

