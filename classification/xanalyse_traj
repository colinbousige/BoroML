def compute_descriptors(atoms, spec=["He"], rcut=15.0, nbins=50, sigma=[1.0, 5.0], w_scale=0.5):
    """Compute LMBTR descriptors for all atoms in an Atoms object

    Args:
        atoms (Atoms): The Atoms object
        spec (list, optional): Species to look at (for acsf, soap, lmbtr). Defaults to ["He"].
        rcut (float, optional): Cutoff in Å. Defaults to 15.0.
        nbins (int, optional): Number of bins (for lmbtr and distrib). Defaults to 50.
        sigma (list, optional): Sigma values for LMBTR. Defaults to [1.0, 5.0].
        w_scale (float, optional): Weighting scale for LMBTR. Defaults to 0.5. w(r)=exp(-w_scale*r), and threshold is 1e-3 (i.e. w(r)<1e-3 are ignored).

    Returns:
        An array of descriptors, dimension Natoms x Ndim where Ndim is the dimension of the used descriptor
    """
    atom = atoms.copy()
    for key in ["momenta", "velocities"]:
        if key in atom.arrays:
            del atom.arrays[key]
    atom.calc = None

    calculator_dist = LMBTR(
        species=spec,
        geometry={"function": "distance"},
        grid={"min": 0, "max": rcut, "n": nbins, "sigma": sigma[0]},
        weighting={"function": "exp", "scale": w_scale, "threshold": 1e-3},
        periodic=False,
        normalization="l2"
    )
    calculator_angle = LMBTR(
        species=spec,
        geometry={"function": "angle"},
        grid={"min": 0, "max": 180, "n": nbins*2, "sigma": sigma[1]},
        weighting={"function": "exp", "scale": w_scale, "threshold": 1e-3},
        periodic=False,
        normalization="l2"
    )

    dist_features = calculator_dist.create(atom, n_jobs=1)
    angle_features = calculator_angle.create(atom, n_jobs=1)

    # Concatenation des features
    desc = []
    for i in range(len(atom)):
        combined = np.hstack([dist_features[i], angle_features[i]])
        desc.append(combined)
    desc = np.array(desc)
    return desc

