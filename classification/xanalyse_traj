def main(args):
    input = args.input
    threshold = args.threshold
    minarea = args.minarea
    maxarea = args.maxarea
    dpi = args.dpi
    setup = args.setup
    pointsize = args.pointsize
    if not input:
        sys.stderr.write(f"\n{orange}Error: No input file provided.{normal}\n")
        exit(1)
    if not os.path.exists(input) or not os.path.isfile(input):
        sys.stderr.write(f"\n{orange}Error: {input} does not exist.{normal}\n")
        exit(1)
    if not input.endswith(".lammpstrj"):
        sys.stderr.write(
            f"\n{orange}Error: {input} is not a LAMMPS trajectory file (.lammpstrj).{normal}\n")
        exit(1)

    if setup:
        sys.stderr.write(f"\n{orange}Running setup for {input}.{normal}\n")
        sys.stderr.flush()
        atoms, timesteps = read_lammps(input)
        holes = detect_holes(atoms[-1], dpi=dpi, pointsize=pointsize,
                             minarea=minarea, maxarea=maxarea, plot=True)
        sys.stderr.write(f"\n{orange}Setup complete for {input}.{normal}\n")
        sys.stderr.flush()
        exit(0)
    else:
        sys.stderr.write(f"\n{orange}Running analysis for {input}.{normal}\n")
        sys.stderr.flush()
        analyse(input, thres=threshold, minarea=minarea,
                maxarea=maxarea, dpi=dpi, pointsize=pointsize)

