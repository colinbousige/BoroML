def predict_allo(atoms, nbins=50, rcut=10.0, sigma=[1.0, 5.0], w_scale=0.5,
                 model=None, xscaler=None, threshold=None, pca=None, encoder=None):
    """
    Predict the allotrope of each atom in an Atoms object using a trained model.
    If the maximum probability is below threshold, assign 'unknown' allotrope.

    Parameters:
    - atoms: ASE Atoms object
    - nbins: Number of bins for histogram-based descriptors
    - rcut: Cutoff radius for descriptor calculation
    - model: Trained model (e.g., RandomForestClassifier, MLPClassifier, SVC)
    - xscaler: Fitted scaler for feature scaling
    - threshold: Confidence threshold for assigning 'unknown'
    - pca: Fitted PCA object for dimensionality reduction
    - encoder: Fitted LabelEncoder for transforming labels

    Returns:
    - ypred: Predicted allotrope for each atom
    """
    desc = compute_descriptors(
        atoms=atoms, nbins=nbins, rcut=rcut, sigma=sigma, w_scale=w_scale)

    if xscaler:
        Xs = xscaler.transform(desc)
    else:
        Xs = desc

    if pca:
        Xs = pca.transform(Xs)

    ypred_proba = model.predict_proba(Xs)

    if not threshold:
        ypred_encoded = model.predict(Xs)
        certainties = np.max(ypred_proba, axis=1)
        if encoder:
            ypred = encoder.inverse_transform(ypred_encoded)
        else:
            ypred = ypred_encoded
    else:

        if encoder:
            # Get the predicted class indices
            pred_indices = np.argmax(ypred_proba, axis=1)
            max_probas = np.max(ypred_proba, axis=1)

            # Decode predictions
            ypred = np.array([
                encoder.inverse_transform([pred_indices[i]])[
                    0] if max_probas[i] >= threshold else 'unknown'
                for i in range(len(pred_indices))
            ])
            certainties = max_probas
        else:
            # For models without encoder (RF, SVM)
            ypred = np.array([
                model.classes_[np.argmax(p)] if np.max(
                    p) >= threshold else 'unknown'
                for p in ypred_proba
            ])
            certainties = np.max(ypred_proba, axis=1)

    return ypred, certainties

