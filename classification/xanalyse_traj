def read_lammps(file):
    """
    Read a LAMMPS trajectory file and return a list of ASE Atoms objects and a list of timesteps.
    """

    with open(file, 'r') as f:
        lines = f.readlines()
    images = []
    timesteps = []
    for i, line in enumerate(lines):
        if "ITEM: TIMESTEP" in line:
            timestep = int(lines[i+1].strip())
            timesteps.append(timestep)
        if "ITEM: NUMBER OF ATOMS" in line:
            natoms = int(lines[i+1].strip())
        if "ITEM: BOX BOUNDS" in line:
            box = []
            for j in range(3):
                box.append([float(x) for x in lines[i+j+1].strip().split()])
        if "ITEM: ATOMS" in line:
            positions = []
            symbols = []
            energies = []
            forces = []
            try:
                for j in range(natoms):
                    parts = lines[i+j+1].strip().split()
                    symbols.append(parts[1])
                    positions.append([float(x) for x in parts[2:5]])
                    if len(parts) >= 6:
                        energies.append(float(parts[5]))
                    if len(parts) >= 9:
                        forces.append([float(x) for x in parts[6:9]])
                at = Atoms(symbols,
                           positions=positions,
                           cell=[[box[0][1], 0, 0], [
                               0, box[1][1], 0], [0, 0, box[2][1]]]
                           )
                at.calc = SinglePointCalculator(at,
                                                energies=energies,
                                                energy=sum(energies),
                                                forces=forces)
            except:
                sys.stderr.write(f"""Error reading atoms: 
- File: {file} 
- Timestep {timestep}
""")
                sys.stderr.flush()
                pass
            images.append(at)
    return images, timesteps

